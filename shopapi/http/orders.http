# Run with the "dev" environment, top to bottom, after a fresh start.

### All orders — 200
GET {{baseUrl}}/api/v1/orders

### Order by id — 200
GET {{baseUrl}}/api/v1/orders/1

### Order by id — 404
GET {{baseUrl}}/api/v1/orders/999

### Create order — 201
POST {{baseUrl}}/api/v1/orders
Content-Type: application/json

{ "product": "Keyboard", "quantity": 1, "price": 25000, "customerId": 2 }

### Create order — 400 (validation)
POST {{baseUrl}}/api/v1/orders
Content-Type: application/json

{ "product": "", "quantity": 0, "price": -5 }

### Create order — 409 (customer does not exist)
POST {{baseUrl}}/api/v1/orders
Content-Type: application/json

{ "product": "Keyboard", "quantity": 1, "price": 25000, "customerId": 999 }

### Create order — 415 (not JSON)
POST {{baseUrl}}/api/v1/orders
Content-Type: text/plain

Keyboard

### Update order — 200
PUT {{baseUrl}}/api/v1/orders/4
Content-Type: application/json

{ "product": "Keyboard", "quantity": 2, "price": 25000, "customerId": 2 }

### Update order — 400 (validation)
PUT {{baseUrl}}/api/v1/orders/4
Content-Type: application/json

{ "product": "Keyboard", "quantity": 500, "price": 25000, "customerId": 2 }

### Update order — 404
PUT {{baseUrl}}/api/v1/orders/999
Content-Type: application/json

{ "product": "Keyboard", "quantity": 1, "price": 25000, "customerId": 2 }

### Update order — 409 (customer does not exist)
PUT {{baseUrl}}/api/v1/orders/4
Content-Type: application/json

{ "product": "Keyboard", "quantity": 1, "price": 25000, "customerId": 999 }

### Delete order — 204
DELETE {{baseUrl}}/api/v1/orders/4

### Delete order — 404 (already deleted)
DELETE {{baseUrl}}/api/v1/orders/4
