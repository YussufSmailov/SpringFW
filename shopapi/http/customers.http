# Run with the "dev" environment, top to bottom, after a fresh start.
# Sample data: customers 1–2, orders 1–3.

### All customers — 200
GET {{baseUrl}}/api/v1/customers

### Customer by id — 200
GET {{baseUrl}}/api/v1/customers/1

### Customer by id — 404
GET {{baseUrl}}/api/v1/customers/999

### Customer by id — 400 (id is not a number)
GET {{baseUrl}}/api/v1/customers/abc

### Orders of a customer — 200
GET {{baseUrl}}

### Orders of a customer — 404
GET {{baseUrl}}/api/v1/customers/999/orders

### Create customer — 201
POST {{baseUrl}}/api/v1/customers
Content-Type: application/json

{ "name": "Dana Omarova", "email": "dana@example.com" }

### Create customer — 400 (validation)
POST {{baseUrl}}/api/v1/customers
Content-Type: application/json

{ "name": "", "email": "not-an-email" }

### Create customer — 400 (broken JSON)
POST {{baseUrl}}/api/v1/customers
Content-Type: application/json

{ "name": "Dana", "email": }

### Create customer — 409 (e-mail already used)
POST {{baseUrl}}/api/v1/customers
Content-Type: application/json

{ "name": "Another Aliya", "email": "aliya@example.com" }

### Update customer — 200
PUT {{baseUrl}}/api/v1/customers/3
Content-Type: application/json

{ "name": "Dana Omarova", "email": "dana.omarova@example.com" }

### Update customer — 404
PUT {{baseUrl}}/api/v1/customers/999
Content-Type: application/json

{ "name": "Nobody", "email": "nobody@example.com" }

### Update customer — 409 (e-mail of another customer)
PUT {{baseUrl}}/api/v1/customers/3
Content-Type: application/json

{ "name": "Dana Omarova", "email": "timur@example.com" }

### Delete customer — 409 (has orders)
DELETE {{baseUrl}}/api/v1/customers/1

### Delete customer — 204
DELETE {{baseUrl}}/api/v1/customers/3

### Delete customer — 404 (already deleted)
DELETE {{baseUrl}}/api/v1/customers/3

### Wrong method — 405
PATCH {{baseUrl}}/api/v1/customers/1

### Wrong URL — 404
GET {{baseUrl}}/api/v1/products
